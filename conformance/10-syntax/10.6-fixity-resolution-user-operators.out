("l0",((a<@b)<@c))
("r1",(a@>(b@>c)))
("n2 with tighter",((a.+.b)<?>(c.+.d)))
("r3",(a&&&(b&&&c)))
("l4",((a+?b)+?c))
("r5",(a+:(b+:c)))
("l6",((a.+.b).+.c))
("l7",((a.*.b).*.c))
("r8",(a.^.(b.^.c)))
("l9",((a.!.b).!.c))
("default fixity infixl 9 symbol",((a%%b)%%c),((a%%b).^.c))
("default fixity infixl 9 backquote",((a`op`b)`op`c),((a.!.b)`op`c))
("ladder up",(a<@(b@>(c<?>d))))
("ladder 6 7 8",(a.+.(b.*.(c.^.d))))
("ladder 8 7 6",(((a.^.b).*.c).+.d))
("mixed",((a.+.(b.*.c)).+.d))
("mixed2",((a.*.b).+.(c.*.d)))
("r5 over l4",((a+:b)+?(c+:d)))
("r3 under r5",((a+:b)&&&(c+:d)))
("zero level split",(((a.+.b)<@(c.*.d))<@a))
("r1 and l0",((a@>b)<@(c@>d)))
("9 vs application",(a.!.(b`op`c)))
("with parens",((a.+.b).*.(c.+.d)))
("section left",((a.^.b).*.c))
("section right",(c.*.(a.^.b)))
("section of tighter left operand",((a.*.b).+.c))
("section same-level left assoc",((a.+.b).+.c))
("section same-level right assoc",(c.^.(a.^.b)))
("backquote section",(b`op`a),(a`op`b))

cabal-version:   3.0
name:            powder-build
version:         0.1.0.0
synopsis:        Powder's build tool: packages, compiled apart and in parallel
license:         BSD-3-Clause
license-file:    LICENSE
author:          Chris McDearman
build-type:      Simple

common shared
  default-language:   GHC2021
  default-extensions: LambdaCase
  ghc-options:        -Wall
  build-depends:      base >=4.18 && <5

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    Powder.Build
    Powder.Build.Fingerprint
    Powder.Build.Graph
    Powder.Build.Manifest
    Powder.Build.Status

  other-modules:   Paths_powder_build
  autogen-modules: Paths_powder_build
  build-depends:
    , binary
    , bytestring
    , containers
    , directory
    , filepath
    , powder

executable powder
  import:         shared
  hs-source-dirs: app
  main-is:        Main.hs
  ghc-options:    -O2 -threaded -rtsopts "-with-rtsopts=-N"
  build-depends:
    , bytestring
    , directory
    , filepath
    , powder
    , powder-build
    , process

test-suite buildtools
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Spec.hs
  other-modules:  ConformanceSpec
  ghc-options:    -threaded -rtsopts "-with-rtsopts=-N4"
  build-depends:
    , containers
    , directory
    , filepath
    , hspec
    , powder
    , powder-build
